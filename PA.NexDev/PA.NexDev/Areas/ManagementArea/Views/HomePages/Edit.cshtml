@model HomePage


<div class="col-12">
    <div class="card">
        <div class="card-header">
            <h1 style="display:inline-block">Ana Sayfa Düzenle</h1>
            <a asp-area="ManagementArea" asp-controller="HomePages" asp-action="Index" class="btn btn-warning" style="float:right;">Geri</a>
        </div>

        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">

                @Html.AntiForgeryToken()
                @Html.HiddenFor(x => x.Id)
                @Html.HiddenFor(x => x.ImageUrl)

                <div asp-validation-summary="ModelOnly" style="color:red;"></div>

                <div class="mb-6">
                    <label class="form-label" asp-for="PageTitle"></label>
                    <input type="text" class="form-control" asp-for="PageTitle" />
                    <span asp-validation-for="PageTitle" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="PageDescription"></label>
                    <textarea class="form-control" asp-for="PageDescription"></textarea>
                    <span asp-validation-for="PageDescription" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="ImageUrl"></label>
                    <input type="file" class="form-control" name="img" />
                    <span asp-validation-for="ImageUrl" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="PartnersTitle"></label>
                    <input type="text" class="form-control" asp-for="PartnersTitle" />
                    <span asp-validation-for="PartnersTitle" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="ProjectTitle"></label>
                    <input type="text" class="form-control" asp-for="ProjectTitle" />
                    <span asp-validation-for="ProjectTitle" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="ProjectDescription"></label>
                    <textarea class="form-control" asp-for="ProjectDescription"></textarea>
                    <span asp-validation-for="ProjectDescription" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="ProjectButtonTitle"></label>
                    <input type="text" class="form-control" asp-for="ProjectButtonTitle" />
                    <span asp-validation-for="ProjectButtonTitle" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="ProjectButtonUrl"></label>
                    <input type="text" class="form-control" asp-for="ProjectButtonUrl" />
                    <span asp-validation-for="ProjectButtonUrl" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="IdeaTitle"></label>
                    <input type="text" class="form-control" asp-for="IdeaTitle" />
                    <span asp-validation-for="IdeaTitle" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="IdeaDescription"></label>
                    <textarea class="form-control" asp-for="IdeaDescription"></textarea>
                    <span asp-validation-for="IdeaDescription" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="IdeaButtonTitle"></label>
                    <input type="text" class="form-control" asp-for="IdeaButtonTitle" />
                    <span asp-validation-for="IdeaButtonTitle" style="color:red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="IdeaButtonUrl"></label>
                    <input type="text" class="form-control" asp-for="IdeaButtonUrl" />
                    <span asp-validation-for="IdeaButtonUrl" style="color:red;"></span>
                </div>

                <button type="submit" class="btn btn-primary">Kaydet</button>
            </form>

        </div>
    </div>
</div>