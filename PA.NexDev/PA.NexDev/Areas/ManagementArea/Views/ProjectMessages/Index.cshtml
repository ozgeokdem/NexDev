@model IEnumerable<ProjectMessage>

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <h1 style="display:inline-block;">Proje Mesajları</h1>
        </div>

        <div class="card-body">
            <div class="table-responsive text-nowrap">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Proje Ad</th>
                            <th>Ad Soyad</th>
                            <th>E-posta</th>
                            <th>Talep</th>
                            <th>Gönderim Tarihi</th>
                            <th>Durum</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody class="table-border-bottom-0">
                        @foreach (var item in Model)
                        {
                            <tr class="@(item.IsReaded ? "" : "fw-bold")">
                                <td>@item.ProjeName</td>
                                <td>@item.FullName</td>
                                <td>@item.Email</td>
                                <td>@item.Message</td>
                                <td>@item.SendDate?.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    @if (item.IsReaded)
                                    {
                                        <span class="badge bg-label-success">Okundu</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-label-warning">Okunmadı</span>
                                    }
                                </td>
                                <td>
                                    <a class="btn btn-info" asp-action="Detail" asp-route-id="@item.Id">
                                        <i class="icon-base bx bx-show me-1"></i>Detay
                                    </a>
                                    <button type="button" onclick="Delete('@item.Id', this)" class="btn btn-danger">
                                        <i class="icon-base bx bx-trash me-1"></i>Sil
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script>
        function Delete(id, elem) {
            $.ajax({
                url: "/ManagementArea/ProjectMessages/Delete/" + id,
                method: "post",
                data: {},
                success: function (e) {
                    if (e.status == true) {
                        $(elem).closest("tr").remove();
                    }
                    else {
                        alert(e.message);
                    }
                },
                error: function () {
                    alert("Bir hata oluştu!");
                }
            });
        }
    </script>
}
