@model IEnumerable<ProjectItem>


<div class="col-12">
    <div class="card">

        <div class="card-header">
            <h1 style="display:inline-block;">Projeler Sayfası Projeleri</h1>
            <a asp-area="ManagementArea"
               asp-controller="ProjectPageProject"
               asp-action="Create" class="btn btn-primary" style="float:right;">Yeni Ekle</a>
        </div>

        <div class="card-body">
            <div class="table-responsive text-nowrap">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Görsel</th>
                            <th>Başlık</th>
                            <th>Açıklama</th>
                            <th>Buton Metni</th>
                            <th>Buton Url</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody class="table-border-bottom-0">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@item.ImageUrl" width="100" />
                                </td>
                                <td>@item.Title</td>
                                <td>@item.Description</td>
                                <td>@item.ButtonTitle</td>
                                <td>@item.ButtonUrl</td>

                                <td>
                                    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@item.Id"><i class="icon-base bx bx-pencil me-1"></i>Düzenle</a>

                                    <a class="btn btn-warning" asp-area="ManagementArea" asp-controller="ProjectDetails" asp-action="Edit" asp-route-id="@item.Id"><i class="icon-base bx bx-pencil me-1"></i>Proje</a>

                                    <button onclick="Delete('@item.Id', this)" class="btn btn-danger"><i class="icon-base bx bx-trash me-1"></i>Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script>
        function Delete(id, elem) {
            $.ajax({
                url: "/ManagementArea/ProjectPageProject/Delete/" + id,
                method: "post",
                data: {},
                success: function(e) {
                    if (e.status == true) {
                        $(elem).closest("tr").remove();
                    }
                    else{
                        alert(e.Message);
                    }
                },
                error: function(e){
                    alert("Bir hata oluştu!");
                }
            })
        }
    </script>
}