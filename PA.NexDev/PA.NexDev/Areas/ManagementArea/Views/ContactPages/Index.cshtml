@model ContactPage

<div class="col-12">
    <div class="card">

        <div class="card-header">
            <h1 style="display:inline-block;">İletişim Sayfası</h1>
            <a asp-area="ManagementArea"
               asp-controller="ContactPages"
               asp-action="Edit" class="btn btn-warning" style="float:right;">Düzenle</a>
        </div>

        <div class="card-body">
            <div class="mb-6">
                <h5>Sayfa Başlığı</h5>
                <p>@Model.PageTitle</p>
            </div>

            <div class="mb-6">
                <h5>Sayfa Açıklaması</h5>
                <p>@Model.PageDescription</p>
            </div>

            <div class="mb-6">
                <h5>Kart 1 İkon Sınıfı</h5>
                <p>@Model.Card1IconClass</p>
            </div>

            <div class="mb-6">
                <h5>Kart 1 Başlığı</h5>
                <p>@Model.Card1Title</p>
            </div>

            <div class="mb-6">
                <h5>PageTitle</h5>
                <p>@Model.PageTitle</p>
            </div>

            <div class="mb-6">
                <h5>Kart 1 Açıklaması</h5>
                <p>@Model.Card1Description</p>
            </div>

            <div class="mb-6">
                <h5>Kart 2 İkon Sınıfı</h5>
                <p>@Model.Card2IconClass</p>
            </div>

            <div class="mb-6">
                <h5>Kart 2 Başlığı</h5>
                <p>@Model.Card2Title</p>
            </div>

            <div class="mb-6">
                <h5>Kart 2 Açıklaması</h5>
                <p>@Model.Card2Description</p>
            </div>

            <div class="mb-6">
                <h5>Kart 3 İkon Sınıfı</h5>
                <p>@Model.Card3IconClass</p>
            </div>

            <div class="mb-6">
                <h5>Kart 3 Başlığı</h5>
                <p>@Model.Card3Title</p>
            </div>

            <div class="mb-6">
                <h5>Kart 3 Açıklaması</h5>
                <p>@Model.Card3Description</p>
            </div>

            <div class="mb-6">
                <h5>Form Adı</h5>
                <p>@Model.FormName</p>
            </div>

            <div class="mb-6">
                <h5>Form E-posta</h5>
                <p>@Model.FormEmail</p>
            </div>

            <div class="mb-6">
                <h5>Form Konu</h5>
                <p>@Model.FormSubject</p>
            </div>

            <div class="mb-6">
                <h5>Form Mesajı</h5>
                <p>@Model.FormMessage</p>
            </div>

            <div class="mb-6">
                <h5>Form Butonu Başlığı</h5>
                <p>@Model.FormButtonTitle</p>
            </div>

        </div>
    </div>
</div>