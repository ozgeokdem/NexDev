@model AboutPage

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <h1 style="display:inline-block">Hakkımızda Sayfası</h1>
            <a asp-area="ManagementArea" asp-controller="AboutPages" asp-action="Edit" class="btn btn-warning" style="float:right;">Düzenle</a>
        </div>

        <div class="card-body">
            <div class="mb-2">
                <h3>Sayfa Başlığı</h3>
                <p>@Model.PageTitle</p>
            </div>

            <div class="mb-2">
                <h3>Sayfa Açıklaması</h3>
                <p>@Model.PageDescription</p>
            </div>

            <div class="mb-2">
                <h3>Resim</h3>
                <img src="@Model.ImageUrl" width="100px"/>
            </div>

            <div class="mb-2">
                <h3>Hakkımızda Başlığı</h3>
                <p>@Model.AboutTitle</p>
            </div>

            <div class="mb-2">
                <h3>Hakkımızda Açıklaması</h3>
                <p>@Model.AboutDescription</p>
            </div>

            <div class="mb-2">
                <h3>Proje Numarası</h3>
                <p>@Model.ProjectNumber</p>
            </div>

            <div class="mb-2">
                <h3>Proje Başlığı</h3>
                <p>@Model.ProjectTitle</p>
            </div>

            <div class="mb-2">
                <h3>Müşteri Numarası</h3>
                <p>@Model.CustomerNumber</p>
            </div>

            <div class="mb-2">
                <h3>Müşteri Başlığı</h3>
                <p>@Model.CustomerTitle</p>
            </div>

            <div class="mb-2">
                <h3>Destek Numarası</h3>
                <p>@Model.SupportNumber</p>
            </div>

            <div class="mb-2">
                <h3>Destek Başlığı</h3>
                <p>@Model.SupportTitle</p>
            </div>

            <div class="mb-2">
                <h3>Yorum Başlığı</h3>
                <p>@Model.TestimonialTitle</p>
            </div>

            <div class="mb-2">
                <h3>Yorum Açıklaması</h3>
                <p>@Model.TestimonialDescription</p>
            </div>

        </div>
    </div>
</div>